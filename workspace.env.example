# Optional settings for historical launchers. Copy to workspace.local.env and
# set paths to your separately acquired checkpoint and data assets.
export ZETA0_ROOT="${ZETA0_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)}"
export PYTHON_BIN="${PYTHON_BIN:-$ZETA0_ROOT/.venv-posttrain/bin/python}"
export ZETA0_INIT_JOINT="${ZETA0_INIT_JOINT:-$ZETA0_ROOT/models/predictive_world/joint-15000}"
export ZETA0_POSTTRAIN_ASSET_ROOT="${ZETA0_POSTTRAIN_ASSET_ROOT:-$ZETA0_ROOT/posttrain_assets}"
export ZETA0_OUTPUT_ROOT="${ZETA0_OUTPUT_ROOT:-$ZETA0_ROOT/posttrain_runs/joint}"
